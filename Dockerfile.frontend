FROM nginx:alpine

COPY frontend/dashboard/dashboard.html /usr/share/nginx/html/index.html
COPY frontend/dashboard/dashboard.css /usr/share/nginx/html/dashboard.css
COPY frontend/dashboard/dashboard.js /usr/share/nginx/html/dashboard.js
COPY frontend/dashboard/auth.js /usr/share/nginx/html/auth.js

COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]